    "fmt": "biome check --write ."
  },
  "dependencies": {
    "@opentui/core": "0.9.9",
    "@opentui/react": "0.9.9",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
