{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": { "includes": ["src/**", "test/**", "bin/**", "*.json", "!test/__snapshots__"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended", "a11y": { "noStaticElementInteractions": "off" }, "suspicious": { "noArrayIndexKey": "off" } }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
